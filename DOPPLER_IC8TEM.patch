+}
+/////////////////// Doppler tracking (IC8TEM mod) ///////////////////
+// Sign convention (same as MSHV/WSJT-X astro): a signal sent on F is received on F + Doppler.
+// dop_full = one-way Doppler Me->Moon->DX  (xdop1 + xdop2)
+// dop_self = own echo Doppler              (2 * xdop1)
+void HvAstroDataW::closeEvent(QCloseEvent*)
+{
+    if (dop_emit_active)//stop tracking, return the rig to the sked frequency
+    {
+        dop_emit_active = false;
+        emit EmitDopplerFreqs(false,sked_hz,sked_hz);
+    }
+    emit EmitAstroWIsClosed();
+}
+double HvAstroDataW::DopScale()
+{
+    // astro() works with integer MHz of the band (e.g. 432 or 1200 for "1.2 GHz"),
+    // Doppler is proportional to frequency -> scale to the real sked frequency
+    if (dop_nfreq_raw<=0 || sked_hz<=0.0) return 1.0;
+    return sked_hz/((double)dop_nfreq_raw*1.0e6);
+}
+void HvAstroDataW::ComputeDoppler(double &rx,double &tx)
+{
+    double k = DopScale();
+    double full = dop_full_raw*k;
+    double self = dop_self_raw*k;
+    double x1 = 0.5*self;       // one-way Me <-> Moon
+    double x2 = full - x1;      // one-way Moon <-> DX
+    rx = sked_hz;
+    tx = sked_hz;
+    if (dop_valid)
+    {
+        switch (dop_method)
+        {
+        case DOP_FULL:
+            rx = sked_hz + full;
+            tx = sked_hz - full;
+            break;
+        case DOP_OWN_ECHO:
+            rx = sked_hz + self;
+            tx = sked_hz;
+            break;
+        case DOP_CFOM:
+            rx = sked_hz + x1;
+            tx = sked_hz - x1;
+            break;
+        case DOP_ON_DX_ECHO:
+        case DOP_CALL_DX:
+            if (!dop_frozen_valid)
+            {
+                dop_dxecho_frozen = 2.0*x2;// DX echo Doppler at QSO start
+                dop_frozen_valid = true;
+            }
+            rx = sked_hz + full;
+            tx = sked_hz + dop_dxecho_frozen - full;
+            break;
+        default:
+            break;
+        }
+    }
+    if (cb_tx_shift->isChecked()) tx += sb_tx_shift->value()*1.0e6;
+}
+QString HvAstroDataW::FormatHz(double hz)
+{
+    if (hz<=0.0) return "---";
+    long long int f = (long long int)floor(hz+0.5);
+    long long int mhz = f/1000000;
+    int khz = (int)((f/1000)%1000);
+    int h = (int)(f%1000);
+    return QString("%1,%2 %3").arg(mhz).arg(khz,3,10,QChar('0')).arg(h,3,10,QChar('0'));
+}
+void HvAstroDataW::UpdateDoppler(bool force_emit)
+{
+    double rx = sked_hz;
+    double tx = sked_hz;
+    if (sked_hz>0.0) ComputeDoppler(rx,tx);
+
+    l_rx_frq->setText(FormatHz(rx));
+    l_tx_frq->setText(FormatHz(tx));
+
+    // tracking only while this window is open and the sked frequency is known
+    bool want_active = isVisible() && sked_hz>0.0 && dop_valid &&
+                       (dop_method!=DOP_NONE || cb_tx_shift->isChecked());
+    if (want_active)
+    {
+        if (force_emit || !dop_emit_active || fabs(rx-last_rx_cmd)>=1.0 || fabs(tx-last_tx_cmd)>=1.0)
+        {
+            if (!dop_emit_active || force_emit) t_last_cmd = QDateTime::currentDateTimeUtc();
+            prev_rx_cmd = dop_emit_active ? last_rx_cmd : floor(rx+0.5);
+            last_rx_cmd = floor(rx+0.5);
+            last_tx_cmd = floor(tx+0.5);
+            dop_emit_active = true;
+            emit EmitDopplerFreqs(true,last_rx_cmd,last_tx_cmd);
+        }
+    }
+    else if (dop_emit_active)
+    {
+        dop_emit_active = false;
+        last_rx_cmd = sked_hz;
+        last_tx_cmd = sked_hz;
+        t_last_cmd = QDateTime::currentDateTimeUtc();
+        emit EmitDopplerFreqs(false,sked_hz,sked_hz);
+    }
+}
+void HvAstroDataW::SetRigFreq(QString shz)
+{
+    double hz = shz.toDouble();
+    if (hz<=0.0) return;
+    rig_hz = hz;
+    if (!dop_emit_active)
+    {
+        // no tracking: the sked frequency simply follows the dial
+        if (fabs(sked_hz-hz)>=1.0)
+        {
+            sked_hz = hz;
+            dop_frozen_valid = false;
+            UpdateDoppler(false);
+        }
+        return;
+    }
+    // tracking active: the operator turned the VFO knob ?
+    if (f_txrx) return;// during TX the rig reports the TX frequency
+    if (t_last_cmd.msecsTo(QDateTime::currentDateTimeUtc())<3000) return;// wait for the rig to settle
+    double diff = hz - last_rx_cmd;
+    // our own commands (last or previous, the rig may report late) +/- rig rounding (10 Hz steps etc.)
+    double tol = 50.0 + fabs(last_rx_cmd - prev_rx_cmd);
+    if (fabs(diff)<=tol || fabs(hz - prev_rx_cmd)<=50.0) return;
+    if (fabs(diff)>1.0e6) sked_hz = hz;// other band
+    else sked_hz += diff;// keep the same correction, move the sked
+    dop_frozen_valid = false;
+    UpdateDoppler(true);
+}
+void HvAstroDataW::SetAppSetFreq(QString shz)
+{
+    double hz = shz.toDouble();
+    if (hz<=0.0) return;
+    sked_hz = hz;// MSHV commanded a new dial frequency -> new sked
+    dop_frozen_valid = false;
+    UpdateDoppler(true);
+}
+void HvAstroDataW::DopplerMethodChanged(bool f)
+{
+    if (!f) return;// handle only the button that became checked
+    int prev = dop_method;
+    for (int i = 0; i < DOP_COUNT; ++i)
+    {
+        if (rb_dop[i]->isChecked()) dop_method = i;
+    }
+    if (prev == dop_method) return;
+    dop_frozen_valid = false;
+    if (dop_method==DOP_CALL_DX && sked_hz>0.0 && dop_valid)
+    {
+        // the DX is heard on the present RX dial: his TX frequency = RX dial - Dop(Me-Moon-DX)
+        double rx_now = dop_emit_active ? last_rx_cmd : (rig_hz>0.0 ? rig_hz : sked_hz);
+        sked_hz = floor(rx_now - dop_full_raw*DopScale() + 0.5);
+    }
+    UpdateDoppler(true);
+}
+void HvAstroDataW::SetSkedKhz()
+{
+    double base = sked_hz;
+    if (base<=0.0) base = rig_hz;
+    if (base<=0.0) return;
+    double mhz = floor(base/1.0e6);
+    sked_hz = mhz*1.0e6 + (double)sb_sked_khz->value()*1.0e3;
+    dop_frozen_valid = false;
+    UpdateDoppler(true);
+}
+void HvAstroDataW::DopplerParmsChanged()
+{
+    UpdateDoppler(true);
 }
+QString HvAstroDataW::GetDopplerSettings()
+{
+    return QString("%1").arg(dop_method)+"#"+QString("%1").arg(sb_sked_khz->value())+"#"+
+           QString("%1").arg(sb_tx_shift->value(),0,'f',3)+"#"+QString("%1").arg((int)cb_tx_shift->isChecked());
+}
+void HvAstroDataW::SetDopplerSettings(QString s)
+{
+    QStringList l = s.split("#");
+    if (l.count()<4) return;
+    int m = l.at(0).toInt();
+    if (m>=0 && m<DOP_COUNT && m!=DOP_CALL_DX) rb_dop[m]->setChecked(true);// Call DX is never restored
+    sb_sked_khz->setValue(l.at(1).toInt());
+    sb_tx_shift->setValue(l.at(2).toDouble());
+    cb_tx_shift->setChecked(l.at(3)=="1");
+}
