+/////////////////// Doppler tracking (IC8TEM mod) ///////////////////
+#define DOP_SET_MS 60  // ms between CAT frequency set and PTT change
+void HvRigControl::SetDopplerFreqs(bool active,double rx_hz,double tx_hz)
+{
+    long long int rxi = (long long int)floor(rx_hz+0.5);
+    long long int txi = (long long int)floor(tx_hz+0.5);
+    if (!active)
+    {
+        if (!dop_active) return;
+        if (dop_in_tx)//switched off during TX: finish at PTT off (back to sked)
+        {
+            dop_rx = rxi;
+            dop_off_pending = true;
+            return;
+        }
+        dop_active = false;
+        dop_rx = rxi;
+        dop_tx = rxi;
+        if (rig_cat_active_and_read && rxi>0 && !dop_in_tx) SetFreq(QString("%1").arg(rxi),3);//back to sked
+        dop_last_set = -1;
+        if (rig_cat_active_and_read && !dop_in_tx)
+        {
+            gb_static_tx->setEnabled(true);
+            RbSetStaticTxF(false);//restore Static TX if it was selected
+        }
+        return;
+    }
+    dop_off_pending = false;
+    if (!dop_active)
+    {
+        dop_active = true;
+        dop_last_set = -1;
+        if (f_static_tx)//Static TX moves the dial on TX -> not compatible with Doppler tracking
+        {
+            int fst = sb_static_tx->value();
+            if (s_mode==11 && f_msf) fst = 750;
+            emit EmitStaticTxFrq(false,fst);
+            f_static_tx = false;
+            corr_app_ind_tx_frq = 0;
+        }
+        gb_static_tx->setEnabled(false);
+    }
+    dop_rx = rxi;
+    dop_tx = txi;
+    if (!rig_cat_active_and_read) return;
+    long long int want = dop_in_tx ? dop_tx : dop_rx;//also during TX (CFOM etc. need TX tracking)
+    if (want>0 && want!=dop_last_set)
+    {
+        SetFreq(QString("%1").arg(want),3);//3=frq,no mod
+        dop_last_set = want;
+    }
+}
+void HvRigControl::DopResendRx()
+{
+    //some rigs ignore a frequency command sent just after PTT off -> send again
+    if (!dop_in_tx && rig_cat_active_and_read && dop_rx>0 && dop_last_set==dop_rx)
+    {
+        SetFreq(QString("%1").arg(dop_rx),3);
+        dop_last_set = dop_rx;
+    }
+}
+/////////////////// END Doppler tracking (IC8TEM mod) ///////////////////
 void HvRigControl::SetPtt(bool flag, int id)//id 0=All 1=p1 2=p2
 {   
+    if (dop_active && rig_cat_active_and_read && !f_static_tx_active && !timer_try_static_tx_isActive)//Doppler tracking (IC8TEM mod)
+    {
+        if (flag)
+        {
+            dop_in_tx = true;
+            if (dop_tx>0 && dop_tx!=dop_last_set)
+            {
+                SetFreq(QString("%1").arg(dop_tx),3);//TX frequency before PTT
+                dop_last_set = dop_tx;
+                usleep(DOP_SET_MS*1000);
+            }
+            SetPtt_p(true,id);
+            gb_static_tx->setEnabled(false);
+            emit EmitTxActive(1);//0=off TX, 1=normal TX, 2=Static TX
+        }
+        else
+        {
+            SetPtt_p(false,id);
+            dop_in_tx = false;
+            if (dop_rx>0 && dop_rx!=dop_last_set)
+            {
+                usleep(DOP_SET_MS*1000);
+                SetFreq(QString("%1").arg(dop_rx),3);//RX frequency after PTT off
+                dop_last_set = dop_rx;
+                QTimer::singleShot(350, this, SLOT(DopResendRx()));
+            }
+            if (dop_off_pending)//tracking was switched off during TX
+            {
+                dop_off_pending = false;
+                dop_active = false;
+                gb_static_tx->setEnabled(true);
+                RbSetStaticTxF(false);
+            }
+            emit EmitTxActive(0);//0=off TX, 1=normal TX, 2=Static TX
+        }
+        return;
+    }
+    if (!flag) dop_in_tx = false;//IC8TEM
 	//if (flag) qDebug()<<"SetPtt====== TO TX"<<flag<<id;
 	//else  qDebug()<<"SetPtt=RX"<<flag<<id;	
     bool all_sttx = false;  //ft8  ft4 q65
@@ -2106,7 +2212,7 @@
         }
         else
         {
-            if (rig_cat_active_and_read) gb_static_tx->setEnabled(true);//2.30
